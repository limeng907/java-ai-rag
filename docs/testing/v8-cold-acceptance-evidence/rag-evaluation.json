  "citationSample": [
    {
      "question": "Does HashMap protect concurrent writes?",
      "expectedDocument": "HashMap",
      "citedDocumentIds": [
        3,
        4
      ],
      "answer": "结论：HashMap 不会为并发写入提供保护。所选知识库的 HashMap 条目明确写着 HashMap 不是线程安全的，扩容（resize）可能与写入发生竞争，因此在多线程同时写入时，不能依赖 HashMap 自身保证安全。若要保护并发写入，知识库中的 ConcurrentHashMap 条目指出它通过内部同步支持并发访问，并且不允许 null 键。知识库未收录 Hashtable、Collections.synchronizedMap 等其它替代方案的内容，因此不再展开。",
      "expectedSourcePresent": true,
      "onlyExpectedSource": false
    },
    {
      "question": "Which map supports concurrent access without external locking?",
      "expectedDocument": "ConcurrentHashMap",
      "citedDocumentIds": [
        4,
        3
      ],
      "answer": "根据所选知识库，`ConcurrentHashMap` 支持并发访问，它通过内部同步机制保证并发安全，因此外部调用方无需额外加锁（K1）。作为对照，`HashMap` 不是线程安全的，写操作可能与扩容竞争（K3），所以在多线程场景下不应直接依赖它而免于外部加锁。另外，知识库还提到 `ConcurrentHashMap` 不允许 null 键（K1）。",
      "expectedSourcePresent": true,
      "onlyExpectedSource": false
    },
