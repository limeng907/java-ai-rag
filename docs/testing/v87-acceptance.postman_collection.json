    {
      "name": "03 Profile A",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/agent/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('120 minutes',()=>pm.expect(pm.response.json().data.dailyMinutes).to.eql(120));"
            ]
