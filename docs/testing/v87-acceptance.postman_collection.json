    },
    {
      "name": "05 Deny B private knowledge to A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/agent/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"HashMap\", \"knowledgeBaseIds\": [302]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Chat with real tool",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/agent/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"conversationId\": null, \"message\": \"请调用 getInterviewHistory 查询最近三次面试，用一句话概括。weaknesses、plan、sources、citations 返回空数组。\", \"knowledgeBaseIds\": []}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "const d=pm.response.json().data;",
              "pm.test('IDs returned',()=>{pm.expect(d.conversationId).to.be.a('string');pm.expect(d.executionId).to.be.a('string');});",
              "pm.collectionVariables.set('chatConversation',d.conversationId);pm.collectionVariables.set('chatExecution',d.executionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Chat execution audit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/agent/executions/{{chatExecution}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "const d=pm.response.json().data;",
              "pm.test('Committed FINISHED',()=>{pm.expect(d.state).to.eql('FINISHED');pm.expect(d.committed_at).to.be.ok;});",
              "pm.test('Actual history tool',()=>pm.expect(d.tools.some(t=>t.tool_name==='getInterviewHistory' && t.status==='SUCCEEDED')).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Deny B access to A conversation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          }
        ],
        "url": "{{baseUrl}}/agent/conversations/{{chatConversation}}/messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Deny B access to A execution",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          }
        ],
        "url": "{{baseUrl}}/agent/executions/{{chatExecution}}"
