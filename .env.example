# Copy to .env and replace every example value before starting Compose.
# .env is ignored by the project and should contain only local credentials.
AI_API_KEY=replace-with-your-deepseek-api-key
DEMO_POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
DEMO_S3_ACCESS_KEY=replace-with-a-unique-object-storage-access-key
DEMO_S3_SECRET_KEY=replace-with-a-long-object-storage-secret
DEMO_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_PORT=18203
QQ_MAIL_AUTH_CODE=replace-with-your-smtp-app-password
