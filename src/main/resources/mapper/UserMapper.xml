<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shtbs.interview.mapper.UserMapper">

    <resultMap id="UserResultMap"
               type="com.shtbs.interview.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectById" resultMap="UserResultMap">
        SELECT id, username, password, email, create_time, update_time
        FROM app_user
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="com.shtbs.interview.vo.UserVO">
        SELECT id, username, email
        FROM app_user
        ORDER BY id
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countUsers" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM app_user
    </select>

    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT id, username, password, email, create_time, update_time
        FROM app_user
        WHERE username = #{username}
    </select>

    <insert id="insert"
            parameterType="com.shtbs.interview.entity.User"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO app_user
        (username, password, email, create_time, update_time)
        VALUES
        (#{username}, #{password}, #{email}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE app_user
        SET username = #{username},
        password = #{password},
        email = #{email},
        update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM app_user
        WHERE id = #{id}
    </delete>

</mapper>
